; Engine configuration file.
; Edit through Godot when possible.

config_version=5

[application]

config/name="Despachante do Apocalipse"
run/main_scene="res://scenes/main/Main.tscn"
config/icon="res://assets/icons/app_icon.svg"

[autoload]

App="*res://scripts/autoload/App.gd"
ContentDb="*res://scripts/autoload/ContentDb.gd"
SaveService="*res://scripts/autoload/SaveService.gd"
SettingsService="*res://scripts/autoload/SettingsService.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

